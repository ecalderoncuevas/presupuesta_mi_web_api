# Copia este archivo como .env.local (en esta misma carpeta frontend/) y pon tu clave.
# .env.local está en .gitignore: NUNCA se sube al repositorio.

# Clave secreta de OpenAI (https://platform.openai.com/api-keys). Solo la lee el servidor.
OPENAI_API_KEY=sk-pon-aqui-tu-clave

# Opcional: modelo de OpenAI (por defecto gpt-4.1-mini)
# OPENAI_MODEL=gpt-4.1-mini
